{
  // Type-checks everything (`npm run typecheck`) with the settings of a typical
  // app that copies src/: bundler resolution, extensionless imports.
  // Node runs the tests and scripts via type stripping plus scripts/ts-resolve.ts.
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // libavoid-js ships broken .d.ts files
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "bench", "scripts", "demo"],
  // separate Angular project with its own tsconfig
  "exclude": ["bench/angular", "demo/build"]
}
