{
  "name": "cytoscape-libavoid",
  "version": "0.1.0",
  "private": true,
  "description": "Cytoscape.js extension: obstacle-avoiding orthogonal edge routing with libavoid (WebAssembly), incl. docking ports that give every edge its own place on the node side",
  "type": "module",
  "scripts": {
    "typecheck": "tsc && tsc -p tsconfig.strict.json",
    "test": "node --import ./scripts/ts-resolve.ts --test \"test/**/*.test.ts\"",
    "perf": "node --import ./scripts/ts-resolve.ts bench/perf.ts",
    "build:demo": "node scripts/build-demo.ts",
    "demo": "npm run build:demo && node scripts/serve.ts",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\""
  },
  "author": "Philipp Kabala",
  "license": "MIT",
  "dependencies": {
    "libavoid-js": "^0.5.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "cytoscape": "^3.34.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkabalski/cytoscape-libavoid.git"
  },
  "homepage": "https://github.com/pkabalski/cytoscape-libavoid#readme",
  "bugs": {
    "url": "https://github.com/pkabalski/cytoscape-libavoid/issues"
  },
  "engines": {
    "node": ">=22.18"
  }
}
