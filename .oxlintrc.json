{
  // `npm run lint`; oxlint's default rules (correctness) plus these settings
  "ignorePatterns": ["demo/build/**", "bench/angular/**"],
  "rules": {
    // the loops delete from the collection they iterate, the copies make that obvious
    "unicorn/no-useless-spread": "off",
    // load.ts: makes the libavoid-js stub typings available in projects that copy src/
    "typescript/triple-slash-reference": "off",
    // public is the default, so it is left out
    "typescript/explicit-member-accessibility": ["error", { "accessibility": "no-public" }],
    // braces around every if / else / for / while body, also one-liners
    "eslint/curly": ["error", "all"],
    // no empty blocks or catches: errors are handled or reported, never swallowed
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error"
  }
}
