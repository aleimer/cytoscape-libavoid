{
  // Emits lib/ (ES modules + declarations) for npm consumers.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src", "types"],
  // bundled by esbuild only (imports the inlined wasm); its API equals lib/index.d.ts
  "exclude": ["src/standalone.ts"]
}
