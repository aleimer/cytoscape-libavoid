{
  "size": "M",
  "zones": ["zone", "zone-outside", "zoneless"],
  "scenarios": ["idle", "drag", "panzoom", "data", "addRemove", "collapseExpand"],
  "runs": [
    { "name": "cytoscape only", "plugins": [] },
    { "name": "plugins, no libavoid", "plugins": ["gridGuide", "expandCollapse", "htmlLabel"] },
    { "name": "libavoid only", "plugins": ["libavoid"] },
    { "name": "libavoid only, route every frame", "plugins": ["libavoid"], "dragRouteInterval": 0 },
    { "name": "libavoid only, worker", "plugins": ["libavoid"], "worker": true },
    { "name": "all", "plugins": ["libavoid", "gridGuide", "expandCollapse", "htmlLabel"] },
    { "name": "all, worker", "plugins": ["libavoid", "gridGuide", "expandCollapse", "htmlLabel"], "worker": true },
    { "name": "all, no drag routing", "plugins": ["libavoid", "gridGuide", "expandCollapse", "htmlLabel"], "rerouteOnDrag": false }
  ]
}
